{
  "name": "new-hsk-1-course-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NEW HSK 1 Chinese course website — Phase 1 complete (15 lessons, 1276 audio clips); Phase 2 implemented (student sign-in + progress sync + teacher dashboard via Google Apps Script), awaiting deployment config.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --config vite.preview.config.ts",
    "preview": "vite preview",
    "smoke": "tsx --import ./test/register.mjs test/smoke.ts",
    "test:remote": "tsx --import ./test/register.mjs test/remote.ts",
    "audio:manifest": "tsx scripts/export_audio_manifest.ts",
    "lessons:export": "tsx scripts/export_lessons.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
